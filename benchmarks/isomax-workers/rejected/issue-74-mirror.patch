@@ -9,6 +9,22 @@ import { IsoMaxTransitionCache } from '../isomax-index.mjs';
 import { IsometricState } from '../state.mjs';
 import { makeCorpus } from '../../../benchmarks/isomax-ordering/corpus.mjs';
 
+test('maintained mirror support matches reconstruction at every imported prefix and undo', () => {
+  const pool = new ResidualPool();
+  for (const { moves } of makeCorpus({ seed: 7742, ply: 36, count: 32 })) {
+    const state = new IsometricState({ pool });
+    for (const column of moves) {
+      state.applyUnchecked(column);
+      assert.equal(state.mirroredSupportCode, state.reflectedSupportCodeFromState());
+      const mirror = new IsometricState({ pool, moves: moves.slice(0, state.ply).map(c => 6 - c) });
+      assert.equal(state.mirroredSupportCode, mirror.supportCode);
+      assert.deepEqual(state.gameplayKey(), mirror.gameplayKey());
+    }
+    while (state.undo()) assert.equal(state.mirroredSupportCode, state.reflectedSupportCodeFromState());
+    assert.equal(state.mirroredSupportCode, 0);
+  }
+});
