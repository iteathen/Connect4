diff --git a/components/isometric/test/hit-first.test.mjs b/components/isometric/test/hit-first.test.mjs
new file mode 100644
--- /dev/null
+++ b/components/isometric/test/hit-first.test.mjs
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { ResidualPool } from '../residual-pool.mjs';
+import { IsoMaxTransitionCache } from '../isomax-index.mjs';
+import { IsometricState } from '../state.mjs';
+import { makeCorpus } from '../../../benchmarks/isomax-ordering/corpus.mjs';
+
+test('chunk and class exact hits do not grow at the sealed hash threshold', () => {
+  const pool = new ResidualPool(), chunk = pool.slotPools[0];
+  const words = new Uint32Array(2);
+  const empty = chunk.intern(words, 0);
+  for (let i = 1; (chunk.count + 1) * 10 < chunk.hashSlots.length * 7; i++) {
+    words[0] = i; chunk.intern(words, 0);
+  }
+  const hash = chunk.hashSlots;
+  chunk.sealed = true; words[0] = 0;
+  assert.equal(chunk.intern(words, 0), empty);
+  assert.strictEqual(chunk.hashSlots, hash);
+  words[0] = 0xffffffff;
+  assert.throws(() => chunk.intern(words, 0), /HASH_CAPACITY/);
+  chunk.sealed = false; chunk.intern(words, 0);
+  assert.equal(chunk.hashSlots.length, hash.length * 2);
+  words[0] = 0; assert.equal(chunk.intern(words, 0), empty);
+
+  // Distinct same-degree initial terms are valid incomparable antichains.
+  const ids = pool.profile.initialIds, bits = new Uint32Array(20);
+  let a = 0, b = 1;
+  const nextPair = () => {
+    bits.fill(0);
+    bits[ids[a] >>> 5] |= 1 << (ids[a] & 31);
+    bits[ids[b] >>> 5] |= 1 << (ids[b] & 31);
+    if (++b === ids.length) { a++; b = a + 1; }
+  };
+  while ((pool.classCount + 1) * 10 < pool.classHashSlots.length * 7) {
+    nextPair(); pool.internBits(bits);
+  }
+  const classHash = pool.classHashSlots, count = pool.classCount;
+  pool.sealed = true;
+  assert.equal(pool.internBits(bits), count - 1);
+  assert.strictEqual(pool.classHashSlots, classHash);
+  nextPair(); assert.throws(() => pool.internBits(bits), /HASH_CAPACITY/);
+  pool.sealed = false; pool.internBits(bits);
+  assert.equal(pool.classHashSlots.length, classHash.length * 2);
+  assert.equal(pool.classCount, count + 1);
+});
+
+test('state and prepared cache overwrites survive sealed threshold; misses still require growth', () => {
+  for (const prepared of [false, true]) {
+    const pool = new ResidualPool(), cache = new IsoMaxTransitionCache({ pool, initialCapacity: 8 });
+    const states = makeCorpus({ seed: 82, ply: 20, count: 6 }).map(({ moves }) => new IsometricState({ pool, moves }));
+    const write = (state, value) => {
+      if (!prepared) return cache.set(state, value);
+      const h = cache.prepareKey(state);
+      return cache.setPreparedUnchecked(cache.scratch[0], cache.scratch[1], cache.scratch[2] >>> 0, h, value);
+    };
+    for (let i = 0; i < 5; i++) write(states[i], i);
+    assert.equal(cache.count, 5); assert.equal(cache.capacity, 8);
+    cache.sealed = true; write(states[2], 42);
+    assert.equal(cache.get(states[2]), 42); assert.equal(cache.capacity, 8);
+    assert.throws(() => write(states[5], 5), /TRANSITION_CAPACITY/);
+    cache.sealed = false; write(states[5], 5);
+    assert.equal(cache.capacity, 16); assert.equal(cache.count, 6);
+    for (let i = 0; i < 6; i++) assert.equal(cache.get(states[i]), i === 2 ? 42 : i);
+  }
+});
