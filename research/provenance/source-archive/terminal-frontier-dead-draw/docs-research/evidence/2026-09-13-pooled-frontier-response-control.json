  "theorem": {
    "name": "pooled-frontier paired-response safety theorem",
    "attacker": "side to move",
    "frontier_pool": "current playable cell from each column with odd remaining capacity",
    "pool_guard": "frontier-pool cardinality is even",
    "vertical_pairing": "after omitting each pool cell, pair each remaining column suffix bottom-up; upper mate is defender response",
    "coverage_guard": "every surviving attacker residual requirement intersects the upper-response set",
    "policy": [
      "attacker plays vertical lower mate -> defender immediately plays upper mate",
      "attacker plays frontier-pool cell -> defender plays any other still-unconsumed frontier-pool cell"
    ],
    "consequence": "side to move cannot force a win"
  },
