{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connect4-discovery-protocol-run-0.1",
  "title": "Connect4 Discovery Protocol Run",
  "type": "object",
  "required": [
    "schema",
    "campaign_id",
    "authority",
    "inputs",
    "runs",
    "synthesis",
    "authority_effect"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "required": [
        "owner",
        "authority_id",
        "revision"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "authority_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lead",
          "observations",
          "semantic_alignment",
          "protocols",
          "hypotheses",
          "residual",
          "qualification_disposition",
          "discovery_disposition"
        ],
        "properties": {
          "lead": {
            "type": "string"
          },
          "observations": {},
          "semantic_alignment": {
            "type": "object",
            "required": [
              "subject",
              "predicate_or_quantity",
              "scope",
              "layer",
              "aggregation",
              "authority",
              "closure"
            ],
            "properties": {
              "subject": {
                "type": [
                  "string",
                  "array",
                  "object",
                  "null"
                ]
              },
              "predicate_or_quantity": {
                "type": [
                  "string",
                  "array",
                  "object",
                  "null"
                ]
              },
              "scope": {
                "type": [
                  "string",
                  "array",
                  "object",
                  "null"
                ]
              },
              "layer": {
                "type": [
                  "string",
                  "array",
                  "object",
                  "null"
                ]
              },
              "aggregation": {
                "type": [
                  "string",
                  "array",
                  "object",
                  "null"
                ]
              },
              "authority": {
                "type": [
                  "string",
                  "array",
                  "object",
                  "null"
                ]
              },
              "closure": {
                "type": [
                  "string",
                  "array",
                  "object",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "protocols": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "hypotheses": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 1
          },
          "immediate_neighborhood_checked": {
            "type": [
              "array",
              "object",
              "string",
              "null"
            ]
          },
          "falsifiers": {
            "type": [
              "array",
              "object",
              "string",
              "null"
            ]
          },
          "residual": {},
          "lifecycle": {
            "type": [
              "string",
              "null"
            ]
          },
          "qualification_disposition": {
            "type": "string"
          },
          "discovery_disposition": {
            "type": "string"
          },
          "authority_effect": {
            "type": [
              "string",
              "object",
              "null"
            ]
          },
          "nei_applicability": {
            "type": [
              "object",
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "synthesis": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "authority_effect": {
      "type": "string"
    },
    "integration": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "nei_layer": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "nei_layer"
        ]
      },
      "then": {
        "properties": {
          "runs": {
            "type": "array",
            "items": {
              "required": [
                "nei_applicability"
              ]
            }
          }
        }
      }
    }
  ]
}
