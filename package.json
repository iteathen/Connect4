{
  "name": "connect4-search-benchmark",
  "version": "0.0.0-dev.0",
  "private": true,
  "description": "Node Connect Four search benchmark and CUDA-MCGS product falsifier",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=26.7.0"
  },
  "sideEffects": false,
  "scripts": {
    "start": "node isomax/run.mjs",
    "test": "node --experimental-ffi --test --test-concurrency=1",
    "test:package": "node --experimental-ffi --test --test-concurrency=1 isomax/test/*.test.mjs",
    "verify": "node isomax/verify.mjs && node tools/verify-main-role.mjs",
    "bench:incumbent": "node benchmarks/incumbent.mjs",
    "bench:strength": "node benchmarks/strength.mjs"
  }
}
