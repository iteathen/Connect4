+test('compiled chunk blocking agrees with uncached residuals across prefix boundaries and geometries', () => {
+  for (const domain of [spec, { columns: 4, rows: 5, connect: 4 }]) {
+    const reference = createSlot64ResidualQuotientKernel(domain, { prefixClasses: 1, blockChunkPrefix: 0 }).kernel;
+    const cached = createSlot64ResidualQuotientKernel(domain, { prefixClasses: 1, blockChunkPrefix: 128 }).kernel;
+    for (let state = 0; state < cached.states.count && state < 6000; state++) {
+      for (let column = 0; column < domain.columns; column++) {
+        assert.equal(cached.advance(state, column), reference.advance(state, column));
+      }
+    }
+    assert.equal(cached.states.count, reference.states.count);
+    assert.equal(cached.classes.size, reference.classes.size);
+    for (let id = 0; id < cached.classes.size; id++) {
+      assert.deepEqual(cached.classes.termIds(id), reference.classes.termIds(id));
+      assert.equal(cached.classes.termCount(id), reference.classes.termCount(id));
+    }
+    assert.ok(cached.classes.metrics.blockChunkCacheHits > 0);
